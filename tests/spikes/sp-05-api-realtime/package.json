{
  "name": "@wayvro-spike/sp-05-api-realtime",
  "private": true,
  "version": "0.0.0",
  "description": "DISPOSABLE Phase-1 spike SP-05: NestJS+Fastify API, Socket.IO gateway with Redis adapter, reconnect/snapshot recovery. Evidence harness only.",
  "type": "module",
  "scripts": {
    "infra:up": "docker compose -f compose.yaml -p wayvro-spike-sp05 up -d --wait",
    "infra:down": "docker compose -f compose.yaml -p wayvro-spike-sp05 down",
    "load": "tsx src/load.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/platform-socket.io": "12.1.2",
    "@nestjs/websockets": "12.1.2",
    "@socket.io/redis-adapter": "8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.4",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
