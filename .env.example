# Local development defaults (synthetic data only). Copy to `.env` if you need to override; `.env` is git-ignored.
# These values match infra/docker/compose.yaml and are NOT secrets. Staging/production configuration comes from the
# deployment secret store, never from files in this repository (Q07).
WAYVRO_ENV=local
LOG_LEVEL=info
DATABASE_URL=postgres://wayvro:wayvro-local-only@127.0.0.1:25432/wayvro
REDIS_URL=redis://127.0.0.1:26379
