# Local development defaults (synthetic data only). Copy to `.env` if you need to override; `.env` is git-ignored.
# These values match infra/docker/compose.yaml and are NOT secrets. Staging/production configuration comes from the
# deployment secret store, never from files in this repository (Q07).
WAYVRO_ENV=local
LOG_LEVEL=info
DATABASE_URL=postgres://wayvro:wayvro-local-only@127.0.0.1:25432/wayvro
REDIS_URL=redis://127.0.0.1:26379
# Synthetic seed for LOCAL/TEST field, lookup and MAC keys (HKDF per key id). Not a secret; refused in staging/production,
# which have no key provider until KMS custody exists (EG-05).
WAYVRO_LOCAL_KEY_SEED=wayvro-local-synthetic-key-seed-not-for-production
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Evidence vault (ADR-041) against the local compose services. Storage keys/credentials below are the local SeaweedFS
# identity (infra/docker/seaweedfs/s3.json) — not secrets. The Android emulator reaches the host as 10.0.2.2.
S3_ENDPOINT=http://127.0.0.1:28333
# S3_PRESIGN_ENDPOINT=http://10.0.2.2:28333
S3_ACCESS_KEY_ID=wayvro-local-access
S3_SECRET_ACCESS_KEY=wayvro-local-secret-not-for-production
S3_FORCE_PATH_STYLE=true
S3_QUARANTINE_BUCKET=wayvro-local
S3_VAULT_BUCKET=wayvro-local
CLAMD_HOST=127.0.0.1
CLAMD_PORT=23310
# One hardened container per image via the Docker CLI (local/CI only): build it with `node scripts/sanitiser-image.mjs`.
SANITISER_RUNNER=docker
# The vault pool must authenticate as a LOGIN member of the NOLOGIN group role wayvro_vault (never the owner); without
# it, evidence routes answer 503. Example (local only): CREATE ROLE wayvro_vault_local LOGIN PASSWORD '...' IN ROLE wayvro_vault;
# DATABASE_VAULT_URL=postgres://wayvro_vault_local:...@127.0.0.1:25432/wayvro
