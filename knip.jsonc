{
  // Knip (ADR-027): unused files, exports and dependencies. CI runs both `knip` (tests count as consumers) and
  // `knip --production` (only production entry points count).
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["java"],
  // Disposable spike harnesses have their own package.json/lockfile outside the workspace (tests/spikes/README.md).
  "ignore": ["tests/spikes/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs!", "infra/ci/**/*.mjs!", "tests/e2e-web/**/*.spec.ts"],
      "project": ["scripts/**/*.mjs!", "infra/**/*.mjs!", "tests/e2e-web/**/*.ts"],
    },
    // The local runner (ADR-045) is a non-production entry: it may use the dev-only test doubles.
    "apps/api": { "entry": ["src/main.ts!", "src/bin/staff-bootstrap.ts!", "dev/main.local.ts"], "project": ["src/**/*.ts!", "dev/**/*.ts", "test/**/*.ts"] },
    "apps/worker": {
      "entry": ["src/main.ts!", "src/bin/key-rotation.ts!"],
      "project": ["src/**/*.ts!", "test/**/*.ts"],
    },
    "apps/realtime": { "entry": ["src/main.ts!"], "project": ["src/**/*.ts!", "test/**/*.ts"] },
    // Local Expo config plugins are referenced by path strings in app.config.ts, which knip does not resolve (F-P3-01).
    "apps/wayvro-mobile": { "entry": ["plugins/*.mjs!"] },
    "apps/web-public": { "project": ["src/**/*.{ts,tsx}!"] },
    "apps/web-ops": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/*": { "entry": ["src/index.ts!"], "project": ["src/**/*.ts!"] },
    "packages/server-runtime": { "entry": ["src/index.ts!"], "project": ["src/**/*.ts!", "test/**/*.ts"] },
    "packages/identity-core": { "entry": ["src/index.ts!"], "project": ["src/**/*.ts!", "test/**/*.ts"] },
    "packages/config": { "entry": ["src/index.ts!", "src/check-flags.ts!"], "project": ["src/**/*.ts!"] },
    "packages/contracts": { "entry": ["src/index.ts!", "src/generate-openapi.ts!"], "project": ["src/**/*.ts!"] },
    "packages/db": { "entry": ["src/index.ts!", "src/bin/migrate.ts!"], "project": ["src/**/*.ts!", "test/**/*.ts"] },
    // The sanitiser's production entry is its container command (infra/sanitiser/Dockerfile → dist/cli.js), ADR-041.
    "packages/image-sanitiser": { "entry": ["src/index.ts!", "src/cli.ts!"], "project": ["src/**/*.ts!"] },
    "packages/vault-adapters": { "entry": ["src/index.ts!"], "project": ["src/**/*.ts!", "test/**/*.ts"] },
    // Phase 3 P3.2 candidate geo adapters; scripts/live-check.mjs is the founder-run real-provider smoke (not production).
    "packages/geo-adapters": { "entry": ["src/index.ts!"], "project": ["src/**/*.ts!", "test/**/*.ts", "scripts/**/*.mjs"] },
    // Dev-only SP-04 harness CLI (its own entry; never a dependency of a deployable app — depcruise geo-bench-dev-only).
    "tools/geo-bench": { "entry": ["src/cli.ts!"], "project": ["src/**/*.ts!", "test/**/*.ts"] },
  },
}
