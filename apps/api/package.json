{
  "name": "@wayvro/api",
  "version": "0.0.0",
  "private": true,
  "description": "Wayvro HTTP API (NestJS 12 on Fastify, ADR-005). Phase 1: health/readiness, request ids, security headers, error envelope and the Idempotency-Key shape only.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts --coverage"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@wayvro/config": "workspace:*",
    "@wayvro/contracts": "workspace:*",
    "@wayvro/db": "workspace:*",
    "@wayvro/observability": "workspace:*",
    "@wayvro/provider-interfaces": "workspace:*",
    "@wayvro/server-runtime": "workspace:*",
    "fastify": "5.12.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
