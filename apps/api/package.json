{
  "name": "@wayvro/api",
  "version": "0.0.0",
  "private": true,
  "description": "Wayvro HTTP API (NestJS 12 on Fastify, ADR-005). Production root src/main.ts binds real adapters only; the local runner dev/main.local.ts (dist-dev/, never deployed) binds the dev-only test doubles (ADR-045).",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:local": "tsc -p tsconfig.dev.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "start:local": "node --env-file-if-exists=../../.env dist-dev/dev/main.local.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "staff:bootstrap": "node --env-file-if-exists=../../.env dist/bin/staff-bootstrap.js"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@simplewebauthn/server": "14.0.3",
    "@wayvro/config": "workspace:*",
    "@wayvro/contracts": "workspace:*",
    "@wayvro/db": "workspace:*",
    "@wayvro/domain": "workspace:*",
    "@wayvro/field-crypto": "workspace:*",
    "@wayvro/identity-core": "workspace:*",
    "@wayvro/legal-content": "workspace:*",
    "@wayvro/observability": "workspace:*",
    "@wayvro/provider-interfaces": "workspace:*",
    "@wayvro/server-runtime": "workspace:*",
    "@wayvro/vault-adapters": "workspace:*",
    "fastify": "5.12.6",
    "jose": "6.2.12",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "@wayvro/provider-test-doubles": "workspace:*",
    "@wayvro/test-support": "workspace:*",
    "fast-check": "4.10.2",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
