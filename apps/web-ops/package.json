  },
  "dependencies": {
    "@wayvro/contracts": "workspace:*",
    "@wayvro/web-security": "workspace:*",
    "next": "16.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "6.0.3"
  }
}
