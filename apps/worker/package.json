{
  "name": "@wayvro/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Wayvro background worker. Phase 1: bootstrap, health endpoint, transactional-outbox relay and idempotent-consumer skeletons (not started until an outbox source exists).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@wayvro/config": "workspace:*",
    "@wayvro/db": "workspace:*",
    "@wayvro/observability": "workspace:*",
    "@wayvro/server-runtime": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
