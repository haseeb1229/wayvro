{
  "name": "@wayvro/server-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "SERVER-ONLY runtime utilities shared by api, worker and realtime: bounded readiness probes and a minimal health server.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts --coverage"
  },
  "dependencies": {
    "@wayvro/config": "workspace:*",
    "@wayvro/contracts": "workspace:*",
    "@wayvro/db": "workspace:*",
    "@wayvro/observability": "workspace:*",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
