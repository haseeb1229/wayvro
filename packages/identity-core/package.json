{
  "name": "@wayvro/identity-core",
  "version": "0.0.0",
  "private": true,
  "description": "SERVER-ONLY identity primitives shared by api, worker and realtime: opaque session tokens, authoritative session verification, versioned phone lookups, the OTP delivery job and resumable key-rotation engines.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts --coverage"
  },
  "dependencies": {
    "@wayvro/field-crypto": "workspace:*",
    "@wayvro/observability": "workspace:*",
    "@wayvro/provider-interfaces": "workspace:*",
    "@wayvro/server-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "@wayvro/db": "workspace:*",
    "@wayvro/provider-test-doubles": "workspace:*",
    "@wayvro/test-support": "workspace:*",
    "fast-check": "4.10.2",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
