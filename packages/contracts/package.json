{
  "name": "@wayvro/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime-validated API/realtime contracts (Zod) and OpenAPI generation. Framework-independent.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "openapi:generate": "node dist/generate-openapi.js"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
